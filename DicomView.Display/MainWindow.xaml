                        <behaviorCores:ItemsDragBehaviorCore ItemsMoved="ItemsMoved2" IsActive="{Binding LeftButton,Mode=TwoWay, Converter={StaticResource behaviorActiveConverter}, ConverterParameter={x:Static behaviors:BehaviorType.Move}}"/>
                    </controllers:DicomImagesBehaviorCoreController.BehaviorCores>
                </controllers:DicomImagesBehaviorCoreController>
            </i:Interaction.Behaviors>
        </ItemsControl>-->
        <Grid Grid.Column="1" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Grid.Row="0">
                <CheckBox Content="AdjustWindow" IsChecked="{Binding LeftButton, Mode=TwoWay, Converter={StaticResource behaviorActiveConverter}, ConverterParameter={x:Static behaviors:BehaviorType.WindowLevel}}"/>
                <CheckBox Content="Move" IsChecked="{Binding LeftButton, Mode=TwoWay, Converter={StaticResource behaviorActiveConverter}, ConverterParameter={x:Static behaviors:BehaviorType.Move}}"/>
            </StackPanel>
            <RadioButton Grid.Row="1" Content="LengthLine" GroupName="ROI" IsChecked="{Binding CurrentROI, Mode=TwoWay, Converter={StaticResource roiTypeConverter}, ConverterParameter={x:Static roi:ROIType.Line}}"/>
        </Grid>
    </Grid>
</Window>
