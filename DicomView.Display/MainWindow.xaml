                            <behaviors:MoveROIBehavior/>
                        </i:Interaction.Behaviors>
                    </view:DicomImageShell>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            <i:Interaction.Behaviors>
                <controllers:DicomImagesBehaviorCoreController x:Name="behaviorsController2" AutoActive="False">
                    <controllers:DicomImagesBehaviorCoreController.BehaviorCores>
                        <behaviorCores:ItemsAdjustWindowCore AdjustWindowAction="TestAdjustWindow2" IsActive="{Binding LeftButton,Mode=TwoWay, Converter={StaticResource behaviorActiveConverter}, ConverterParameter={x:Static behaviors:BehaviorType.WindowLevel}}"/>
